  },
  "description": "React hook for PWA installation detection and handling",
  "devDependencies": {
    "@biomejs/biome": "2.5.11",
    "@serwist/next": "^9.5.12",
    "@testing-library/react": "^16.3.3",
    "@types/node": "25.9.5",
    "@types/react": "^19.2.18",
    "@vercel/analytics": "2.0.1",
    "babel-plugin-react-compiler": "^1.0.0",
    "jsdom": "^29.1.1",
    "lefthook": "^2.1.12",
    "next": "16.3.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "serwist": "^9.5.12",
    "tsup": "^8.5.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "files": [
    "dist"
  ],
  "funding": "https://github.com/sponsors/piro0919",
  "homepage": "https://use-pwa.kkweb.io",
  "keywords": [
    "react",
    "hook",
    "pwa",
    "progressive-web-app",
    "install-prompt",
    "a2hs"
  ],
  "license": "MIT",
  "name": "use-pwa",
  "peerDependencies": {
    "react": ">=17.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/piro0919/use-pwa.git"
  },
  "scripts": {
    "build": "next build",
    "build:lib": "tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "dev": "next dev",
    "format": "biome format --write",
    "lint": "biome check",
    "prepublishOnly": "pnpm test && pnpm build:lib",
    "start": "next start",
    "typecheck": "tsc --noEmit"
  },
  "sideEffects": false,
  "version": "3.1.0"
}
