{
  "author": "piro0919 <piro.haniwa@gmail.com> (https://kkweb.io/)",
  "bugs": {
    "url": "https://github.com/piro0919/use-pwa/issues"
  },
  "description": "React hook for PWA installation detection and handling",
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@biomejs/biome": "2.5.15",
    "@serwist/next": "^9.5.12",
    "@testing-library/react": "^16.3.3",
    "@types/node": "25.9.9",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vercel/analytics": "2.0.1",
    "babel-plugin-react-compiler": "^1.0.0",
    "jsdom": "^29.1.1",
    "lefthook": "^2.1.17",
    "next": "16.4.0",
    "publint": "^0.3.25",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "serwist": "^9.5.12",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": ">=18.20.8"
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "funding": "https://github.com/sponsors/piro0919",
  "homepage": "https://use-pwa.kkweb.io",
  "keywords": [
    "react",
    "hook",
    "pwa",
    "progressive-web-app",
    "install-prompt",
    "a2hs"
  ],
  "license": "MIT",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "name": "use-pwa",
  "packageManager": "pnpm@11.28.3",
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/piro0919/use-pwa.git"
  },
  "scripts": {
    "build": "next build",
    "build:lib": "tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "dev": "next dev",
    "format": "biome format --write",
    "lint": "biome check",
    "prepublishOnly": "pnpm run lint && pnpm run typecheck && pnpm run test && pnpm run build:lib && pnpm run check:package",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "check:package": "publint --strict && attw --pack ."
  },
  "sideEffects": true,
  "types": "./dist/index.d.ts",
  "version": "4.0.0"
}
